# NexusCRM Backend Environment Configuration (Mẫu cấu hình)

PROJECT_NAME="NexusCRM Enterprise Backend API"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Thay thế 'your_mysql_password' bằng mật khẩu MySQL của bạn
DATABASE_URL="mysql+pymysql://root:1206@localhost:3306/nexuscrm_db?charset=utf8mb4"

JWT_SECRET_KEY="nexuscrm-secret-key-change-in-production-2026-very-secure"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REMEMBER_ME_EXPIRE_DAYS=30

MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
